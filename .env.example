# =============================================================================
# DispatchGrid Production & Environment Configuration Template (.env.example)
# Copy this file to .env and configure values before starting the application.
# =============================================================================

# Server Environment & Port
# Render assigns PORT automatically (usually 10000). For local development, fallback is 3000.
PORT=3000
NODE_ENV=production

# Public URL of the deployed application (Render Web Service URL)
# Example: https://dispatchgrid.onrender.com
APP_URL=https://your-service-name.onrender.com

# Database Persistence Path
# On Render, attach a Persistent Disk at mount path /var/data and point DATABASE_PATH there:
# DATABASE_PATH=/var/data/dispatchgrid.db
# For local development, leave blank to use the default ./dispatchgrid.db
DATABASE_PATH=

# Static Uploads Path (Avatars and Profile Photos)
# If left blank, it automatically defaults to the same persistent directory as DATABASE_PATH
# (e.g. /var/data/uploads on Render) or ./uploads in local development.
UPLOADS_PATH=

# Security & Authentication
# Strong, randomly generated 32+ character secret for JWT session tokens
JWT_SECRET=your-random-32-plus-char-jwt-secret-here-replace-in-production

# External Communications / Notifications (Optional)
# If using MSG91 for SMS/Email alerts, provide valid credentials below.
# Set NOTIFICATION_TEST_MODE=true to log alerts to console instead of sending live SMS/email.
NOTIFICATION_TEST_MODE=true
MSG91_AUTH_KEY=
MSG91_SMS_SENDER_ID=
MSG91_SMS_TEMPLATE_ID=
MSG91_EMAIL_CONFIGURED=false
MSG91_EMAIL_SENDER=
MSG91_EMAIL_DOMAIN=

# Admin Monitoring & Alerts (Optional)
ADMIN_NOTIFICATION_EMAIL=admin@dispatchgrid.demo
ADMIN_NOTIFICATION_PHONE=+91-98000-00001
